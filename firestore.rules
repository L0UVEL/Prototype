rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the authenticated user is an admin
    function isAdmin() {
      // Fetch the user's document to check their role.
      // Check both 'roleId' (current schema) and 'role' (legacy) for compatibility.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && (userDoc.data.roleId == 'admin' || userDoc.data.role == 'admin');
    }

    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- User Collection Rules ---
    match /users/{userId} {
      // Users can access their own document. Admins can access all.
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Sub-collections: health_profile, daily_logs
      // Inherit access from parent user document logic (Owner or Admin)
      match /health_profile/{document=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
      
      match /health_updates/{document=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Appointments Collection Rules ---
    match /appointments/{appointmentId} {
      // Read: Owner can see their own appointments. Admins can see all.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      // Create: Users can create appointments for themselves.
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      
      // Update/Delete: Owner or Admin.
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // --- Announcements Collection Rules ---
    match /announcements/{announcementId} {
      // Read: Any authenticated user can read announcements.
      allow read: if isAuthenticated();
      
      // Write: Only Admins can create/edit/delete announcements.
      allow write: if isAuthenticated() && isAdmin();
    }

    // --- AI Chats Collection Rules ---
    match /ai_chats/{chatId} {
      // Read: Users can see their own chats. Admins can see all.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      // Create: Users can only create chats for themselves.
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      
      // Update/Delete: Not allowed for users (chat history is typically immutable)
      allow update, delete: if isAdmin();
    }

    // --- Taken Slots Collection Rules ---
    match /taken_slots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- Roles Collection Rules ---
    match /roles/{roleId} {
      // Any authenticated user can read roles (needed for role lookups)
      allow read: if isAuthenticated();
      // Only admins can modify roles
      allow write: if isAuthenticated() && isAdmin();
    }

    // --- Activity Logs Collection Rules ---
    match /activity_logs/{logId} {
      // Read: Users can see their own activity. Admins can see all.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentId == request.auth.uid);
      
      // Create: Users can only log activity for themselves.
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid);
      
      // Update/Delete: Only Admins
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // --- Sent Emails Collection Rules ---
    match /sent_emails/{emailId} {
      // Admins can read all sent emails
      allow read: if isAuthenticated() && isAdmin();
      // Any authenticated user can create (the system logs emails on behalf of the user)
      allow create: if isAuthenticated();
      // Only admins can update/delete
      allow update, delete: if isAuthenticated() && isAdmin();
    }
    
  }
}
